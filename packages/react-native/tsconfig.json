{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "outDir": "dist",
    // React Native 0.80+ only ships the deep-import ("react-native/Libraries/...")
    // declarations under this resolution condition.
    "customConditions": ["react-native", "react-native-legacy-deep-imports"],
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": [
      "react-native",
      "react"
    ]
  },
  "include": [
    "src/"
  ]
}