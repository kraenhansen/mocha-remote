{
  "name": "mocha-remote-expo-example",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test:android": "mocha-remote -- expo start --android",
    "test:ios": "mocha-remote -- expo start --ios",
    "test:web": "mocha-remote -- expo start --web"
  },
  "nx": {
    "targets": {
      "test:android": {
        "dependsOn": [
          "^build"
        ]
      },
      "test:ios": {
        "dependsOn": [
          "^build"
        ]
      },
      "test:web": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "dependencies": {
    "expo": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "mocha-remote-react-native": "1.13.2",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.2.0"
  }
}
