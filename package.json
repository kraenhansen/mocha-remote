{
  "name": "mocha-remote-root",
  "private": true,
  "description": "Run Mocha tests somewhere - get reporting elsewhere",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "scripts": {
    "lint": "eslint .",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test"
  },
  "author": {
    "name": "Kræn Hansen",
    "email": "mail@kraenhansen.dk",
    "url": "https://github.com/kraenhansen"
  },
  "keywords": [
    "mocha"
  ],
  "repository": "github:kraenhansen/mocha-remote",
  "bugs": "https://github.com/kraenhansen/mocha-remote/issues",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node16": "^16.1.3",
    "@types/chai": "^5.2.3",
    "@types/debug": "^4.1.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@nx/js": "^19.3.2",
    "chai": "^6.2.2",
    "eslint": "^10.11.0",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "mocha": "11.0.1",
    "prettier": "^2.8.8",
    "tsx": "^4.7.3",
    "typescript": "^5.4.5",
    "ws": "^8.21.0",
    "nx": "^23.2.1"
  }
}
